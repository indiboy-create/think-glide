{
  "name": "youvision/think-glide",
  "description": "ThinkPHP8 adapter for using Glide image manipulation library",
  "type": "library",
  "keywords": ["thinkphp", "glide", "think-glide"],
  "license": "MIT",
  "authors": [
    {
      "name": "indiboy-create",
      "homepage": "https://github.com/indiboy-create"
    },
    {
      "name": "AI",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.3",
    "topthink/framework": "^8.0",
    "league/glide": "^4.2",
    "league/flysystem": "^3.0",
    "symfony/options-resolver": "^6.4|^7.0"
  },
  "autoload": {
    "psr-4": {
      "think\\": "src/"
    },
    "files": [
      "src/helper.php"
    ]
  },
  "extra": {
    "think": {
      "config":{
        "glide": "src/config.php"
      }
    }
  }
}
